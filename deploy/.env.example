TZ=Asia/Shanghai
BIND_ADDRESS=0.0.0.0
HOST_PORT=3010
DOCKER_NETWORK=chat-web-infrastructure

REDIS_HOST=chat-web-redis
REDIS_PORT=6379
REDIS_DATABASE=0
# REDIS_USERNAME=default
# REDIS_PASSWORD=replace-with-redis-password
# REDIS_URL=rediss://user:password@example.redis:6379/0

JWT_SECRET=replace-with-at-least-32-random-characters

# FINANCE_MYSQL_HOST=chat-web-mysql
# FINANCE_MYSQL_PORT=3306
# FINANCE_MYSQL_DATABASE=chat-web-finance

NACOS_SERVER=nacos:8848
