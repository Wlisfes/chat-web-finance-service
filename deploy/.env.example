TZ=Asia/Shanghai
BIND_ADDRESS=0.0.0.0
HOST_PORT=3010
DOCKER_NETWORK=chat-web-infrastructure

REDIS_HOST=chat-web-redis
REDIS_PORT=6379
REDIS_DATABASE=1
# REDIS_USERNAME=default
# REDIS_PASSWORD=replace-with-redis-password
# 即使 URL 带其他库号，显式 REDIS_DATABASE=1 仍强制使用 Finance index。
# REDIS_URL=rediss://user:password@example.redis:6379/1

ACCOUNT_SERVICE_URL=http://chat-web-account-service:3000
ACCOUNT_AUTH_TIMEOUT_MS=3000

# 首次创建 Finance Nacos Data ID 时必须填写独立账号；已有配置时空值不会覆盖 Nacos。
FINANCE_MYSQL_HOST=
FINANCE_MYSQL_PORT=3306
FINANCE_MYSQL_DATABASE=chat_web_finance
FINANCE_MYSQL_USERNAME=
FINANCE_MYSQL_PASSWORD=

# 启动阶段连接 Nacos 所必需的参数；两项都没有代码默认值。
NACOS_SERVER=nacos:8848
NACOS_NAMESPACE=replace-with-nacos-namespace-id

# 以下为可选覆盖；未配置时依次使用 5000、服务名.yaml 和 DEFAULT_GROUP。
NACOS_REQUEST_TIMEOUT=5000
NACOS_CONFIG_DATA_ID=chat-web-finance-service.yaml
NACOS_CONFIG_GROUP=DEFAULT_GROUP

# Nacos 开启鉴权时取消注释并填写。
# NACOS_USERNAME=nacos
# NACOS_PASSWORD=replace-with-nacos-password

# 以下服务注册参数均有代码默认值。
NACOS_REGISTER_ENABLED=true
NACOS_REGISTER_REQUIRED=false
NACOS_SERVICE_NAME=chat-web-finance-service
NACOS_GROUP=DEFAULT_GROUP
NACOS_REGISTER_PORT=3010
NACOS_REGISTER_IP=
# 当前节点标识，用于结构化日志区分部署环境。
DEPLOYMENT_ENVIRONMENT=production-home
